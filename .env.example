# Model provider selection: bedrock | anthropic | openai | ollama
STRANDS_MODEL_PROVIDER=ollama

# Database backend selection (see config/database.yaml): sqlite | postgres
APP_DB_BACKEND=sqlite
# sqlite: path is relative to the repo root unless absolute
APP_DB_PATH=data/app.db
# postgres (only if APP_DB_BACKEND=postgres; requires pip install "psycopg[binary]")
# APP_DB_DSN=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=prompt_pioneers
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# Backend API (FastAPI) - the Streamlit app is a thin client calling this URL
API_BASE_URL=http://localhost:8000

# Auth: secret used to sign JWTs issued by the backend (backend/app/security.py).
# If unset, an ephemeral random secret is generated per-process (dev-only fallback);
# set a real value for stable sessions across restarts / any shared deployment.
JWT_SECRET_KEY=

# Bedrock (default provider, uses local AWS credentials/profile)
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Anthropic (only if STRANDS_MODEL_PROVIDER=anthropic) - use non-sensitive/synthetic data only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-3-5-sonnet-latest

# OpenAI (only if STRANDS_MODEL_PROVIDER=openai) - use non-sensitive/synthetic data only
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# Ollama (fully local/on-prem model provider, recommended for restricted data)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=gemma4:31b-cloud

# Vision model used for OCR/description of images and scanned PDF pages
# (uses the same Ollama cloud model for both text and vision work)
OLLAMA_VISION_MODEL=gemma4:31b-cloud

# Tracing/telemetry (OpenTelemetry) - see docs/user-guide/observability-evaluation/traces
STRANDS_TRACE_CONSOLE=true
STRANDS_TRACE_OTLP=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=prompt-pioneers-poc

# Logging
LOG_LEVEL=INFO

# Local vector storage and embeddings
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=scheme_documents
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CHUNK_SIZE=1000
EMBEDDING_CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=32

# Where originally uploaded submission files are kept on disk so ingestion (incl. OCR)
# can be retried later (e.g. via the admin "restart pipeline" action) without a re-upload
UPLOAD_STORAGE_DIR=./data/uploads

# Exa (https://exa.ai) web search - used by the validation agent to check whether an
# applicant's organisation has a genuine, findable public presence online. Only the
# organisation name (never full submission content) is sent to this external API.
# Leave unset to skip this check entirely (validation still runs without it).
EXA_API_KEY=
